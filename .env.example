# Local training sandbox credentials. Copy to .env and adjust if you like.
# These are NOT secrets: the stack runs only on localhost with synthetic data.
# docker-compose reads this file automatically when it is named .env.

MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=analytics
MYSQL_USER=analyst
MYSQL_PASSWORD=analyst

# Token for the local JupyterLab server (http://localhost:8888).
JUPYTER_TOKEN=capitalone
